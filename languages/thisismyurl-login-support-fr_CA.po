#: core/class-timu-core.php:74
msgid "Local-First Promise"
msgstr "Engagement local en premier"

#: core/class-timu-core.php:78
msgid "This plugin is designed to work on your WordPress site without any required cloud account, AI service, license gate, or paywall."
msgstr "Cette extension est conçue pour fonctionner sur votre site WordPress sans nécessiter de compte infonuagique, de service d'IA, de validation de licence ou de mur payant."

#: core/class-timu-core.php:80
msgid "Security controls, recovery tools, logs, and settings stay under the site owner's control."
msgstr "Les contrôles de sécurité, les outils de récupération, les journaux et les paramètres restent sous le contrôle du propriétaire du site."

#: core/class-timu-core.php:91
msgid "thisismyurl icon"
msgstr "icône thisismyurl"

#: core/class-timu-core.php:102
msgid "thisismyurl banner"
msgstr "bannière thisismyurl"

#: core/class-timu-core.php:104
msgid "Plugin Values"
msgstr "Valeurs de l'extension"

#: core/class-timu-core.php:105
msgid "Local-first, no AI required, plain-English controls, and safe recovery paths."
msgstr "Local en premier, sans IA requise, commandes en langage simple et chemins de récupération sécurisés."

#: core/class-timu-core.php:106
msgid "Use the settings on this page to control how login access works for your site."
msgstr "Utilisez les paramètres de cette page pour contrôler le fonctionnement de l'accès à la connexion pour votre site."

#: core/class-timu-core.php:111
msgid "Safety Checklist"
msgstr "Liste de vérification de sécurité"

#: core/class-timu-core.php:114
msgid "Generate a recovery link before changing the secret slug."
msgstr "Générez un lien de récupération avant de modifier le slug secret."

#: core/class-timu-core.php:115
msgid "Test login changes in a private browser window."
msgstr "Testez les modifications de connexion dans une fenêtre de navigation privée."

#: core/class-timu-core.php:116
msgid "Review the security event log after policy changes."
msgstr "Examinez le journal des événements de sécurité après les modifications de politique."

#: core/class-timu-core.php:117
msgid "Review Site Health after major security changes."
msgstr "Vérifiez l'état du site après des modifications de sécurité importantes."

#: thisismyurl-login-support.php:71
msgid "The chosen secret slug is reserved and cannot be used."
msgstr "Le slug secret choisi est réservé et ne peut pas être utilisé."

#: thisismyurl-login-support.php:256
#: thisismyurl-login-support.php:289
msgid "Security check failed."
msgstr "La vérification de sécurité a échoué."

#: thisismyurl-login-support.php:312
#: thisismyurl-login-support.php:313
msgid "Login Support"
msgstr "Support de connexion"

#: thisismyurl-login-support.php:349
msgid "All other user sessions were terminated."
msgstr "Toutes les autres sessions d'utilisateurs ont été terminées."

#: thisismyurl-login-support.php:357
msgid "Security Utilities:"
msgstr "Utilitaires de sécurité :"

#: thisismyurl-login-support.php:360
msgid "Immediately log out all other users?"
msgstr "Déconnecter immédiatement tous les autres utilisateurs ?"

#: thisismyurl-login-support.php:361
msgid "Force Global Logout"
msgstr "Forcer la déconnexion globale"

#: thisismyurl-login-support.php:365
msgid "Generate One-Time Recovery Link"
msgstr "Générer un lien de récupération à usage unique"

#: thisismyurl-login-support.php:370
msgid "Use this one-time URL immediately and store it securely:"
msgstr "Utilisez cette URL à usage unique immédiatement et conservez-la en lieu sûr :"

#: thisismyurl-login-support.php:387
msgid "Configuration"
msgstr "Configuration"

#: thisismyurl-login-support.php:391
msgid "Activate Stealth Mode"
msgstr "Activer le mode furtif"

#: thisismyurl-login-support.php:400
msgid "Secret Slug"
msgstr "Slug secret"

#: thisismyurl-login-support.php:403
msgid "Example: secure-login. Do not use wp-admin or wp-login.php."
msgstr "Exemple : connexion-securisee. N'utilisez pas wp-admin ou wp-login.php."

#: thisismyurl-login-support.php:407
msgid "Enable Recovery Mode"
msgstr "Activer le mode de récupération"

#: thisismyurl-login-support.php:413
msgid "Allow temporary one-time token access to recover login URL access."
msgstr "Autoriser l'accès temporaire par jeton à usage unique pour récupérer l'accès à l'URL de connexion."

#: thisismyurl-login-support.php:417
msgid "Recovery Token Lifetime (minutes)"
msgstr "Durée de vie du jeton de récupération (minutes)"

#: thisismyurl-login-support.php:421
msgid "Enable Login Rate Limiting"
msgstr "Activer la limitation du taux de connexion"

#: thisismyurl-login-support.php:430
msgid "Max Failed Attempts"
msgstr "Nombre maximal de tentatives échouées"

#: thisismyurl-login-support.php:434
msgid "Attempt Window (minutes)"
msgstr "Fenêtre de tentatives (minutes)"

#: thisismyurl-login-support.php:438
msgid "Lockout Duration (minutes)"
msgstr "Durée de verrouillage (minutes)"

#: thisismyurl-login-support.php:442
msgid "Enable Security Event Logging"
msgstr "Activer la journalisation des événements de sécurité"

#: thisismyurl-login-support.php:451
msgid "Log Retention (days)"
msgstr "Conservation des journaux (jours)"

#: thisismyurl-login-support.php:459
msgid "Security Event Log"
msgstr "Journal des événements de sécurité"

#: thisismyurl-login-support.php:462
msgid "Clear all security logs?"
msgstr "Effacer tous les journaux de sécurité ?"

#: thisismyurl-login-support.php:462
msgid "Clear Logs"
msgstr "Effacer les journaux"

#: thisismyurl-login-support.php:467
msgid "Date"
msgstr "Date"

#: thisismyurl-login-support.php:468
msgid "Event"
msgstr "Événement"

#: thisismyurl-login-support.php:469
msgid "User"
msgstr "Utilisateur"

#: thisismyurl-login-support.php:470
msgid "IP"
msgstr "IP"

#: thisismyurl-login-support.php:471
msgid "Details"
msgstr "Détails"

#: thisismyurl-login-support.php:476
msgid "No events recorded yet."
msgstr "Aucun événement enregistré pour l'instant."

#: thisismyurl-login-support.php:492
msgid "Save Settings"
msgstr "Enregistrer les paramètres"

#: thisismyurl-login-support.php:562
msgid "Too many failed attempts. Please try again later."
msgstr "Trop de tentatives échouées. Veuillez réessayer plus tard."

#: thisismyurl-login-support.php:620
msgid "Login Support Security Configuration"
msgstr "Configuration de sécurité du support de connexion"

#: thisismyurl-login-support.php:635
msgid "Stealth Mode is disabled or secret slug is empty."
msgstr "Le mode furtif est désactivé ou le slug secret est vide."

#: thisismyurl-login-support.php:641
msgid "Login rate limiting is disabled."
msgstr "La limitation du taux de connexion est désactivée."

#: thisismyurl-login-support.php:647
msgid "Security event logging is disabled."
msgstr "La journalisation des événements de sécurité est désactivée."

#: thisismyurl-login-support.php:652
msgid "Login Support security controls are active."
msgstr "Les contrôles de sécurité du support de connexion sont actifs."

#: thisismyurl-login-support.php:655
#: thisismyurl-login-support.php:668
msgid "Security"
msgstr "Sécurité"

#: thisismyurl-login-support.php:658
msgid "Stealth mode, rate limiting, and event logging are enabled."
msgstr "Le mode furtif, la limitation du taux et la journalisation des événements sont activés."

#: thisismyurl-login-support.php:665
msgid "Login Support security controls need attention."
msgstr "Les contrôles de sécurité du support de connexion nécessitent votre attention."

#: thisismyurl-login-support.php:675
msgid "Review Login Support settings"
msgstr "Examiner les paramètres du support de connexion"
